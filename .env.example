# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env y completar. El .env real NUNCA se versiona (está en
# .gitignore). Después de crearlo: chmod 600 .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Túnel de Cloudflare ─────────────────────────────────────────────────────
# Zero Trust → Redes → Conectores → tu túnel → Configurar → Docker.
# Es todo lo que va después de `--token` en el comando que muestra.
TUNNEL_TOKEN=

# ─── Analítica (Umami) ───────────────────────────────────────────────────────
# Dejar las cuatro vacías si no se quiere analítica: los sitios se compilan
# sin script de terceros y los contenedores de Umami no hacen falta.
#
# Generar los dos secretos con:
#   openssl rand -base64 32
#
# Contraseña de PostgreSQL. Cambiarla después implica recrear el volumen.
UMAMI_DB_PASSWORD=

# Clave con la que Umami firma las sesiones. Si cambia, se cierran todas.
UMAMI_APP_SECRET=

# URL pública del script de seguimiento. Tiene que coincidir con el subdominio
# que se dé de alta en el túnel y con el origen permitido en la CSP de
# apps/*/nginx.conf.
VITE_ANALYTICS_SRC=https://analytics.ramiroagustin.online/script.js

# ID que Umami asigna a cada sitio. Se obtienen DESPUÉS de crear cada sitio en
# la interfaz de Umami (Settings → Websites → Add website), así que la primera
# vez se levanta con estas vacías y se reconstruye después.
ANALYTICS_ID_RAMIROAGUSTIN=
ANALYTICS_ID_BYTEFIX=

# ─── Taller: órdenes de servicio ─────────────────────────────────────────────
# Contraseña del panel, hasheada. El contenedor no arranca sin esto (salvo con
# TALLER_AUTH=off, que solo tiene sentido en compose.local.yml, con el puerto
# atado a 127.0.0.1).
#
# Se genera con el propio contenedor, dejando esta variable vacía:
#   docker compose run --rm taller node --import tsx src/hash.ts 'LA-QUE-ELIJAS'
# y se pega acá el valor que imprime (empieza con `scrypt:`).
#
# Ojo con los `$` en este archivo: Compose los interpola como variables. Por eso
# el hash usa `:` de separador y no el `$` habitual.
#
# Es la segunda capa, no la única: delante va Cloudflare Access.
TALLER_PASSWORD_HASH=

# URL pública del taller, para armar el enlace de seguimiento que va en el
# correo del cliente. Ejemplo: https://taller.bytefix.shop
#
# Se completa recién cuando pasan LAS DOS cosas: el subdominio resuelve en el
# túnel, y Cloudflare Access ya excluye /seguimiento, /s/* y /estilos.css. Si
# se completa antes, los correos salen con un enlace que no resuelve, o peor:
# que le pide al cliente que inicie sesión en un panel que no es suyo.
#
# Vacía, el correo sale igual: con el número de orden y el PDF, sin el enlace.
TALLER_URL_PUBLICA=

# ─── Correo del comprobante ──────────────────────────────────────────────────
# Gmail con contraseña de aplicación (requiere el 2FA activado en la cuenta:
# https://myaccount.google.com/apppasswords). No es la contraseña de Gmail.
#
# Con estas vacías el sistema funciona igual: las órdenes quedan marcadas como
# "correo sin configurar" y el PDF se descarga desde el panel.
# La contraseña de aplicación se puede pegar tal como la muestra Google, con
# espacios o sin ellos: se limpian al leerla.
TALLER_SMTP_USUARIO=
TALLER_SMTP_CLAVE=

# Nombre visible del remitente. La dirección es la de TALLER_SMTP_USUARIO, así
# que el cliente ve el nombre de la marca aunque la casilla sea personal.
TALLER_EMAIL_NOMBRE=ByteFix

# Copia oculta de cada comprobante. Conviene ponerla aunque sea la misma
# casilla que envía: así queda en Recibidos, etiquetable y buscable, y no solo
# en Enviados.
TALLER_EMAIL_COPIA=
