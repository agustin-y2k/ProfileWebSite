# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env y completar. El .env real NUNCA se versiona (está en
# .gitignore). Después de crearlo: chmod 600 .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Túnel de Cloudflare ─────────────────────────────────────────────────────
# Zero Trust → Redes → Conectores → tu túnel → Configurar → Docker.
# Es todo lo que va después de `--token` en el comando que muestra.
TUNNEL_TOKEN=

# ─── Analítica (Umami) ───────────────────────────────────────────────────────
# Dejar las cuatro vacías si no se quiere analítica: los sitios se compilan
# sin script de terceros y los contenedores de Umami no hacen falta.
#
# Generar los dos secretos con:
#   openssl rand -base64 32
#
# Contraseña de PostgreSQL. Cambiarla después implica recrear el volumen.
UMAMI_DB_PASSWORD=

# Clave con la que Umami firma las sesiones. Si cambia, se cierran todas.
UMAMI_APP_SECRET=

# URL pública del script de seguimiento. Tiene que coincidir con el subdominio
# que se dé de alta en el túnel y con el origen permitido en la CSP de
# apps/*/nginx.conf.
VITE_ANALYTICS_SRC=https://analytics.ramiroagustin.online/script.js

# ID que Umami asigna a cada sitio. Se obtienen DESPUÉS de crear cada sitio en
# la interfaz de Umami (Settings → Websites → Add website), así que la primera
# vez se levanta con estas vacías y se reconstruye después.
ANALYTICS_ID_RAMIROAGUSTIN=
ANALYTICS_ID_BYTEFIX=
